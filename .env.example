APP_NAME=WorkSpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Paris

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
# « database » en production (worker : php artisan queue:work), « sync » en local
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Connexion avec Google (console.cloud.google.com → Identifiants OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Alertes e-mail en cas d'erreur serveur (production uniquement)
ERROR_ALERT_EMAIL=

# Copie externe des sauvegardes après backup:run ({dir} = dossier créé), ex. :
# BACKUP_COPY_COMMAND="rclone copy {dir} distant:workspace-backups"
BACKUP_COPY_COMMAND=

VITE_APP_NAME="${APP_NAME}"
